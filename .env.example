# Copia este fichero como ".env" (no se versiona) y rellena los valores.
# docker compose lo lee automáticamente.

# --- Modo de conexión -------------------------------------------------------
# filesystem: no habla con BBVA; lee los catálogos de samples/catalogues y deja
#             los ficheros "enviados" en samples/catalogues/outbox.
# http:       habla con Activity Report. Necesita la credencial (más abajo).
AR_CLIENT=filesystem

# Carpeta (dentro del contenedor) de la que lee el modo filesystem. Para probar
# con los catálogos reales de ejemplo de BBVA, déjalos en samples/real-catalogues
# con el nombre <catalogo>.csv (task_types.csv, jira_issues.csv...) y cambia esta
# variable a /app/samples/real-catalogues. Esa carpeta no se versiona.
AR_LOCAL_DIR=/app/samples/catalogues

# --- Entornos de Activity Report (confirmados por BBVA, octubre 2026) -------
# La API es accesible desde Internet; no hace falta lista blanca de IP.
# BBVA pide probar en DEV y en AU antes de pasar a PRO. Cada entorno tiene su
# propia credencial, y DEV exige además cuentas @dev.bbva.com (se piden por
# el ticket de Helix).
#   DEV:  https://dev-bbva-gateway.appspot.com/timereport/api/vendors
#   AU:   https://au-bbva-gateway.appspot.com/timereport/api/vendors
#   PRO:  https://bbva-gateway.appspot.com/timereport/api/vendors
AR_BASE_URL=https://au-bbva-gateway.appspot.com/timereport/api/vendors

# Email de contratista que va en la cabecera Requestor de cada petición.
# BBVA tiene que tenerlo registrado; puede ser uno o varios, y es a esos
# correos a los que envía la credencial (por Google Drive).
AR_REQUESTOR_EMAIL=nombre.apellido.contractor@bbva.com

# --- Credencial (solo con AR_CLIENT=http) ------------------------------------
# JSON de la cuenta de servicio que entrega BBVA, uno por entorno. Guárdalos
# en la carpeta secrets/ (git la ignora) y pon aquí la ruta de dentro del
# contenedor del que corresponda a AR_BASE_URL (ar-dev.json, ar-au.json, ar-pro.json).
AR_CREDENTIALS_FILE=/app/secrets/ar-au.json

# Cabecera X-BBVA-AppId. BBVA confirma que es el client_id del JSON: déjalo vacío.
AR_APP_ID=

# Token delegado al usuario Requestor. BBVA usa el token de la propia cuenta
# de servicio, sin delegar: déjalo en false.
AR_DELEGATE_TO_REQUESTOR=false

# Nombre del campo del fichero en las subidas. BBVA usa "file".
AR_UPLOAD_FIELD_NAME=file

# false = modo solo lectura: el conector descarga catálogos y feedback pero no
# sube nada, ni desde el job programado ni desde "Enviar ahora". Úsalo en las
# primeras pruebas contra un entorno real, mientras en la base de datos haya
# personas de prueba. Pon true cuando toque empezar a enviar.
AR_UPLOADS_ENABLED=false

# Código GPS de la empresa y geografías de su gente, tal como los tiene BBVA.
# Arktic Business Consulting SL [ESP]: 0000417143. El panel lo propone al dar
# de alta personas.
AR_GPS_CODES=0000417143
AR_GEOGRAPHIES=ES

# --- Panel -------------------------------------------------------------------
# Primer usuario gestor; solo se crea si no hay ningún usuario.
ADMIN_EMAIL=admin@arktic.local
ADMIN_PASSWORD=cambia-esta-clave
PANEL_URL=http://localhost:4200

# --- Copias de seguridad de la base de datos ---------------------------------
# Carpeta del PC donde se guardan. Por defecto, la carpeta backups/ del
# repositorio. Para que un fallo del disco no se lleve también las copias,
# conviene una carpeta sincronizada o de red de Arktic, por ejemplo:
#   BACKUP_DIR=C:/Users/<usuario>/OneDrive - Arktic/ar-connector-backups
# Las copias contienen datos personales (nombres, correos, imputaciones).
BACKUP_DIR=./backups
# Una copia automática cada tantas horas, con la aplicación arrancada.
BACKUP_EVERY_HOURS=24
# Días que se conservan las copias automáticas.
BACKUP_KEEP_DAYS=30

# --- Avisos por correo (opcional) --------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=ar-connector@arktic.local
