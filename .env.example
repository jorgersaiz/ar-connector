# Copia este fichero como ".env" (no se versiona) y rellena los valores.
# docker compose lo lee automáticamente.

# --- Modo de conexión -------------------------------------------------------
# filesystem: no habla con BBVA; lee los catálogos de samples/catalogues y deja
#             los ficheros "enviados" en samples/catalogues/outbox.
# http:       habla con Activity Report. Necesita la credencial (más abajo).
AR_CLIENT=filesystem

# Carpeta (dentro del contenedor) de la que lee el modo filesystem. Para probar
# con los catálogos reales de ejemplo de BBVA, déjalos en samples/real-catalogues
# con el nombre <catalogo>.csv (task_types.csv, jira_issues.csv...) y cambia esta
# variable a /app/samples/real-catalogues. Esa carpeta no se versiona.
AR_LOCAL_DIR=/app/samples/catalogues

# --- Entornos de Activity Report (confirmados por BBVA, septiembre 2026) -----
# La API es accesible desde Internet; no hace falta lista blanca de IP.
#   DEV (cuentas @dev.bbva.com):  https://dev-bbva-gateway.appspot.com/timereport/api/vendors
#   AU  (cuentas @bbva.com):      https://au-bbva-gateway.appspot.com/timereport/api/vendors
#   PRO:                          https://bbva-gateway.appspot.com/timereport/api/vendors
#        (la guía de consumo de APIs indica https://gapis.bbva.com; pendiente de confirmar)
AR_BASE_URL=https://au-bbva-gateway.appspot.com/timereport/api/vendors

# Email de contratista que va en la cabecera Requestor de cada petición.
# BBVA tiene que tenerlo registrado; puede ser uno o varios, y es a esos
# correos a los que envía la credencial (por Google Drive).
AR_REQUESTOR_EMAIL=nombre.apellido.contractor@bbva.com

# --- Credencial (solo con AR_CLIENT=http) ------------------------------------
# JSON de la cuenta de servicio que entrega BBVA. Guárdalo en la carpeta
# secrets/ (git la ignora) y pon aquí la ruta de dentro del contenedor.
AR_CREDENTIALS_FILE=/app/secrets/ar-au.json

# Cabecera X-BBVA-AppId. Vacío = el client_id que viene dentro del JSON.
AR_APP_ID=

# true = el token se pide delegado al usuario Requestor. Si Google responde
# "unauthorized_client", la cuenta de servicio no tiene delegación: déjalo en false.
AR_DELEGATE_TO_REQUESTOR=false

# Nombre del campo del fichero en las subidas (pendiente de confirmar con BBVA).
AR_UPLOAD_FIELD_NAME=file

# Códigos GPS de Arktic y geografías (áreas funcionales) de su gente, tal como
# se hayan comunicado a BBVA.
AR_GPS_CODES=
AR_GEOGRAPHIES=

# --- Panel -------------------------------------------------------------------
# Primer usuario gestor; solo se crea si no hay ningún usuario.
ADMIN_EMAIL=admin@arktic.local
ADMIN_PASSWORD=cambia-esta-clave
PANEL_URL=http://localhost:4200

# --- Avisos por correo (opcional) --------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=ar-connector@arktic.local
